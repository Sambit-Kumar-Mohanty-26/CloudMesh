generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

model Organization {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  plan             Plan     @default(FREE)
  stripeCustomerId String?  @map("stripe_customer_id")
  // Per-org override of billing_plans.monthly_budget_usd for the org's plan
  // tier — null means "use the plan's default," not "unlimited." Lets an
  // enterprise deal negotiate a custom cap without a whole new Plan tier.
  monthlyBudgetOverrideUsd Decimal? @map("monthly_budget_override_usd") @db.Decimal(12, 2)
  featureFlags     Json     @default("{}") @map("feature_flags")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users         User[]
  apiKeys       ApiKey[]
  usageRecords  UsageRecord[]
  semanticCache SemanticCacheEntry[]
  invoices      Invoice[]

  @@map("organizations")
}

// Catalog of plan tiers -> budget/price, not per-org — an org's actual
// effective budget is this row's monthlyBudgetUsd, unless
// Organization.monthlyBudgetOverrideUsd is set. No RLS: this is global
// product config, not tenant data (same category as a price list).
model BillingPlan {
  id               String   @id @default(uuid()) @db.Uuid
  planTier         Plan     @unique @map("plan_tier")
  monthlyBudgetUsd Decimal  @map("monthly_budget_usd") @db.Decimal(12, 2)
  priceUsd         Decimal  @map("price_usd") @db.Decimal(12, 2)
  stripePriceId    String?  @map("stripe_price_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("billing_plans")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  stripeInvoiceId String?       @unique @map("stripe_invoice_id")
  periodStart     DateTime      @map("period_start")
  periodEnd       DateTime      @map("period_end")
  amountUsd       Decimal       @map("amount_usd") @db.Decimal(12, 2)
  status          InvoiceStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, periodStart])
  @@map("invoices")
}

// Dedup log for Stripe webhook deliveries — Stripe redelivers on a timeout
// or non-2xx response, so the same event id can arrive more than once.
// Not tenant data (no org_id at all — a webhook precedes knowing which org
// a Stripe object maps to until the handler looks it up), so no RLS.
model StripeEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  processedAt   DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}

// Transactional outbox (Phase 7 design doc): a usage_records insert and its
// outbox_events row commit atomically, so an event bus outage can never
// silently drop a billing event — the poller just retries until it
// publishes. No RLS: only ever read by the internal poller process, never
// by a tenant-scoped API request.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(MEMBER)
  orgId        String   @map("org_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("users")
}

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  keyHash      String    @unique @map("key_hash")
  keyPrefix    String    @map("key_prefix")
  scopes       String[]
  isActive     Boolean   @default(true) @map("is_active")
  rateLimitRpm Int       @default(60) @map("rate_limit_rpm")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]

  @@index([orgId])
  @@map("api_keys")
}

model UsageRecord {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  apiKeyId         String   @map("api_key_id") @db.Uuid
  model            String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  costUsd          Decimal  @map("cost_usd") @db.Decimal(12, 6)
  requestId        String   @unique @map("request_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("usage_records")
}

model SemanticCacheEntry {
  id         String                   @id @default(uuid()) @db.Uuid
  orgId      String                   @map("org_id") @db.Uuid
  // A cache entry from one model must never satisfy a request for another —
  // responses aren't interchangeable across models even for the same
  // prompt. Part of every lookup/insert/invalidation query, not just stored.
  model      String
  promptHash String                   @map("prompt_hash")
  // vector(1536): column + ivfflat index are created via raw SQL in the
  // RLS/pgvector migration, since Prisma has no native vector column type.
  embedding  Unsupported("vector(1536)")?
  response   String
  createdAt  DateTime                 @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, model])
  @@map("semantic_cache")
}
