{
  "name": "@cloudmesh/gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --env-file=.env src/worker.ts",
    "consumers": "tsx --env-file=.env src/consumers.ts",
    "webhook-worker": "tsx --env-file=.env src/webhookWorker.ts"
  },
  "dependencies": {
    "@cloudmesh/auth": "*",
    "@cloudmesh/billing": "*",
    "@cloudmesh/circuit-breaker": "*",
    "@cloudmesh/db": "*",
    "@cloudmesh/events": "*",
    "@cloudmesh/jobs": "*",
    "@cloudmesh/outbox": "*",
    "@cloudmesh/rate-limiter": "*",
    "@cloudmesh/webhooks": "*",
    "@fastify/websocket": "^11.3.0",
    "bullmq": "^5.81.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.4.1",
    "nats": "^2.29.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "undici": "^7.2.0",
    "vitest": "^2.1.4"
  }
}
