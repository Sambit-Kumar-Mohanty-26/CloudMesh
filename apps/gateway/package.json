{
  "name": "@cloudmesh/gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/instrument.ts server",
    "start": "tsx --env-file=.env src/instrument.ts server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --env-file=.env src/instrument.ts worker",
    "consumers": "tsx --env-file=.env src/instrument.ts consumers",
    "webhook-worker": "tsx --env-file=.env src/instrument.ts webhookWorker"
  },
  "dependencies": {
    "@cloudmesh/auth": "*",
    "@cloudmesh/billing": "*",
    "@cloudmesh/circuit-breaker": "*",
    "@cloudmesh/db": "*",
    "@cloudmesh/events": "*",
    "@cloudmesh/jobs": "*",
    "@cloudmesh/metrics": "*",
    "@cloudmesh/openapi": "*",
    "@cloudmesh/outbox": "*",
    "@cloudmesh/rate-limiter": "*",
    "@cloudmesh/telemetry": "*",
    "@cloudmesh/webhooks": "*",
    "@fastify/websocket": "^11.3.0",
    "bullmq": "^5.81.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "nats": "^2.29.3",
    "tsx": "^4.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.7.0",
    "undici": "^7.2.0",
    "vitest": "^2.1.4"
  }
}
