# Where apps/api and apps/gateway run — the dashboard is a BFF, calling
# both server-to-server, never directly from the browser (see CLAUDE.md's
# Phase 13 notes for why the refresh cookie can't cross origins directly).
CLOUDMESH_API_URL="http://localhost:3000"
CLOUDMESH_GATEWAY_URL="http://localhost:3001"

# Encrypts the dashboard's own session cookie (AES-256-GCM — see
# src/lib/sessionCrypto.ts). Must be at least 32 characters. Required:
# reading or writing a session throws without it, rather than silently
# falling back to storing the refresh token in cleartext.
# Generate with: openssl rand -base64 48
# Rotating it logs every user out (old cookies no longer decrypt), which
# is the intended behavior, not a bug.
SESSION_SECRET="change-me-to-at-least-32-random-characters-abcdefgh"
